// ──新增：系統資源讀取權限（切換身份必要） ──

rule AllParticipantsCanReadSystem {
description: "所有參與者可以讀取 Composer 系統資源"
participant: "edu.thesis.review.*"
operation: READ
resource: "org.hyperledger.composer.system.**"
action: ALLOW
}

rule AllParticipantsCanWriteHistorian {
description: "所有參與者可以寫入交易歷史紀錄"
participant: "edu.thesis.review.*"
operation: CREATE
resource: "org.hyperledger.composer.system.HistorianRecord"
action: ALLOW
}

// ──系統管理員 ──

rule NetworkAdminUser {
description: "網路管理員擁有所有權限"
participant: "org.hyperledger.composer.system.NetworkAdmin"
operation: ALL
resource: "**"
action: ALLOW
}

rule NetworkAdminSystem {
description: "系統管理員可操作系統資源"
participant: "org.hyperledger.composer.system.NetworkAdmin"
operation: ALL
resource: "org.hyperledger.composer.system.**"
action: ALLOW
}

// ──最後：拒絕其餘所有操作 ──

rule DenyAll {
description: "拒絕所有未明確授權的操作"
participant: "ANY"
operation: ALL
resource: "**"
action: DENY
}
