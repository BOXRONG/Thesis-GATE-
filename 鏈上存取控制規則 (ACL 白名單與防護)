ACL
rule StudentReadOwnThesis {
description: "學生可以讀取自己的論文"
participant(p): "edu.thesis.review.Student"
operation: READ
resource(r): "edu.thesis.review.Thesis"
condition: (r.student.getIdentifier() === p.getIdentifier())
action: ALLOW
}

rule StudentCanUpdateThesisWork {
description: "學生可以提交 UpdateThesisWork 交易"
participant: "edu.thesis.review.Student"
operation: CREATE
resource: "edu.thesis.review.UpdateThesisWork"
action: ALLOW
}

rule StudentCanSubmitToGate {
description: "學生可以提交 SubmitToGate 交易"
participant: "edu.thesis.review.Student"
operation: CREATE
resource: "edu.thesis.review.SubmitToGate"
action: ALLOW
}

rule StudentCanUpdateThesisAsset {
description: "學生可以更新自己的論文資產"
participant(p): "edu.thesis.review.Student"
operation: UPDATE
resource(r): "edu.thesis.review.Thesis"
condition: (r.student.getIdentifier() === p.getIdentifier())
action: ALLOW
}

